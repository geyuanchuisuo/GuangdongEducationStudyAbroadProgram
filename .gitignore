# Office临时文件
~$*

# Dify 运行时数据卷（不入库，首次启动自动生成）
dify/docker/volumes/
# Dify init 生成的 app key（含敏感信息，不入库）
dify/docker/app_keys.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
*.egg-info/
dist/
build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量
.env
.env.local
.env.*.local
# Dify 默认 .env 含启动必需配置（DB/redis 默认密码，无个人密钥），允许入库
!dify/docker/.env

# 本地文件存储（STORAGE_BACKEND=local 落盘目录）
storage_data/
backend/storage_data/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# 日志
*.log

*.rar