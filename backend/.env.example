# 数据库（MySQL）
DATABASE_URL=mysql+aiomysql://root:420821@localhost:59000/GuangdongEducationStudyAbroadProgram

MYSQL_USER=root
MYSQL_PASSWORD=420821

# Redis
REDIS_URL=redis://localhost:6379

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dify（版本: 1.16.0-rc1，已一体化打包进 docker-compose，Service API 走 /v1/chat-messages）
# Docker 容器内由 docker-compose.yml 覆盖为 http://dify_nginx；本机直接跑 uvicorn 时用 http://localhost:8081
DIFY_BASE_URL=http://localhost:8081
DIFY_VERSION=1.16.0-rc1
DIFY_API_PROTOCOL=openai
# 四个 Key（三个业务 Agent + 智能报告）由 dify-init 写入 dify_app_keys 命名卷（/run/dify-keys/app_keys.env），
# backend 容器启动时自动加载，无需手动回填；仅本机直跑 uvicorn 时才需手动填入下方变量（留空则对应 Agent 降级）
DIFY_STUDENT_AGENT_KEY=app-xxx
DIFY_EMPLOYEE_AGENT_KEY=app-yyy
DIFY_CUSTOMER_AGENT_KEY=app-zzz
DIFY_REPORT_AGENT_KEY=app-rpt

# 直连模型降级（可选）：Dify Agent 不可用时，直接调用 OpenAI-API-compatible 模型生成兜底回复
# 三个值默认全空（不绑定任何特定模型）；启用时由客户自定义填写，留空则跳过直连降级，走本地话术兜底
DIFY_MODEL_API_KEY=
DIFY_MODEL_BASE_URL=
DIFY_MODEL_NAME=

# 文件存储（一期默认 local 本地磁盘，零外部依赖；二期生产可切 s3=MinIO）
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data
# 以下仅 STORAGE_BACKEND=s3 时生效
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=education
